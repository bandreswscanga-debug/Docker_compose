# ============================================
# Ejemplo de configuración (.env.example)
# Copia a .env y reemplaza los valores reales.
# NUNCA subas .env con secretos reales al repositorio.
# ============================================

# --- Aplicación ---
APP_ENV=production
APP_PORT=5050

# --- Base de datos MySQL ---
# DB_HOST debe ser el nombre del servicio Docker, NO localhost
DB_HOST=servidor-bd
DB_PORT=3306
DB_NAME=cambia_por_tu_bd
DB_USER=cambia_por_tu_usuario
DB_PASSWORD=cambia_por_tu_password
MYSQL_ROOT_PASSWORD=cambia_por_root_password
MYSQL_DATABASE=cambia_por_tu_bd
MYSQL_USER=cambia_por_tu_usuario
MYSQL_PASSWORD=cambia_por_tu_password
